# Base URL of the API. On a physical phone use your computer's LAN IP address
# (the phone and computer must be on the same Wi-Fi), e.g. http://192.168.1.20:4000
# Android emulator: http://10.0.2.2:4000   iOS simulator: http://localhost:4000
# Use https:// in production.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
