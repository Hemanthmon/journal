{
  "name": "@journal/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run build -w @journal/shared",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @journal/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "db:create": "tsx src/db/create-db-cli.ts",
    "pretest": "npm run build -w @journal/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@journal/shared": "*",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
