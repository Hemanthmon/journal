# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MySQL. For a hosted database (e.g. Aiven) use its host/port/user/password,
# set DB_SSL=1 and point DB_SSL_CA_PATH at the provider's CA certificate.
# Create the database with: npm run db:create -w @journal/api
# For a local server, scripts/setup-db.sql creates a least-privilege user instead.
DB_HOST=your-service.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=change-me
DB_NAME=journal
DB_SSL=1
DB_SSL_CA_PATH=certs/ca.pem

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed by CORS. The native app does not need CORS.
CORS_ORIGINS=http://localhost:8081

# Set to 1 when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=0

# Auth rate limit: max attempts per 15 minutes (per IP, and per email for login).
AUTH_RATE_LIMIT_MAX=10

# --- Read-only web dashboard (optional; leave the session secret empty to disable) ---
# Owners share access from the app (Profile → Dashboard access). These two lines
# additionally grant one viewer from the server.
# The viewer logs in with an emailed one-time code and sees the owner's records.
DASHBOARD_VIEWER_EMAIL=
# Optional: the owner's app account. Leave empty when the database has a single account.
DASHBOARD_OWNER_EMAIL=
# At least 32 random characters, different from JWT_ACCESS_SECRET.
DASHBOARD_SESSION_SECRET=
# Sign-out after this many hours without using the dashboard (renewed on every visit).
DASHBOARD_SESSION_HOURS=168
# brevo (production) or console (development: codes printed to the server log)
MAIL_PROVIDER=console
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Journal
